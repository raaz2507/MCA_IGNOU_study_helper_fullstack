{
  "name": "gyanpath-mca-study-helper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('backend/dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run prisma:generate && tsc -p backend/tsconfig.json",
    "start": "node backend/dist/src/server.js",
    "test": "tsx --test --test-concurrency=1 backend/src/tests/*.test.ts",
    "prisma:generate": "prisma generate --schema backend/prisma/providers/sqlite/schema.prisma",
    "prisma:push": "prisma db push --schema backend/prisma/providers/sqlite/schema.prisma",
    "prisma:seed": "tsx backend/prisma/seed.ts",
    "content:scan": "tsx backend/src/infrastructure/content/generate-content-manifest.ts",
    "content:sync:github": "tsx backend/src/infrastructure/content/sync-github-content.ts"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "eta": "^4.6.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
